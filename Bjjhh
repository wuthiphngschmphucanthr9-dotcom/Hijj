-- ฟังก์ชันถืออุปกรณ์ทั้งหมดอัตโนมัติ (Auto Equip Any Lift Tool)
local function AutoEquipLiftTool()
    local char = LocalPlayer.Character
    if not char then return end

    -- เช็กอุปกรณ์ในกระเป๋าแล้วถือทันที
    for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name == "Weight" or tool.Name == "Pushups" or tool.Name == "Situps" or tool.Name == "Punch" or tool.Name == "Handstands") then
            char.Humanoid:EquipTool(tool)
            break
        end
    end
end

-- ลูปทำงาน Auto Lift ความเร็วสูงสุด (Micro Delay / Max Speed)
task.spawn(function()
    while true do
        task.wait() -- Fast Render Delay
        if Config.AutoLiftMax then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("Humanoid") then
                    -- 1. ถืออุปกรณ์อัตโนมัติหากยังไม่ได้ถือ
                    if not char:FindFirstChildOfClass("Tool") then
                        AutoEquipLiftTool()
                    end

                    -- 2. สแปมยิง Remote Event ความเร็วสูงสุด
                    local muscleEvent = LocalPlayer:FindFirstChild("muscleEvent") or ReplicatedStorage:FindFirstChild("muscleEvent")
                    if muscleEvent then
                        muscleEvent:FireServer("rep")
                    end

                    -- 3. สแปมใช้ไอเทม Tool ในมือ
                    local currentTool = char:FindFirstChildOfClass("Tool")
                    if currentTool then
                        currentTool:Activate()
                    end
                end
            end)
        end
    end
end)

