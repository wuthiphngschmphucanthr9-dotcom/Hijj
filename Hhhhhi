local function CreateToggle(parent, text, defaultState, callback)
    local ToggleFrame = Instance.new("Frame")
    ToggleFrame.Size = UDim2.new(1, -10, 0, 42)
    ToggleFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    ToggleFrame.Parent = parent

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = ToggleFrame

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.68, 0, 1, 0)
    Label.Position = UDim2.new(0, 12, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.TextColor3 = Color3.fromRGB(230, 230, 240)
    Label.Font = Enum.Font.Gotham
    Label.TextSize = 13
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = ToggleFrame

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0, 48, 0, 24)
    Btn.Position = UDim2.new(1, -58, 0.5, -12)
    Btn.BackgroundColor3 = defaultState and Color3.fromRGB(255, 85, 127) or Color3.fromRGB(45, 45, 60)
    Btn.Text = ""
    Btn.Parent = ToggleFrame

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(1, 0)
    BtnCorner.Parent = Btn

    local Dot = Instance.new("Frame")
    Dot.Size = UDim2.new(0, 18, 0, 18)
    Dot.Position = defaultState and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
    Dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Dot.Parent = Btn

    local DotCorner = Instance.new("UICorner")
    DotCorner.CornerRadius = UDim.new(1, 0)
    DotCorner.Parent = Dot

    local state = defaultState
    Btn.MouseButton1Click:Connect(function()
        state = not state
        local targetDotPos = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
        local targetBtnBg = state and Color3.fromRGB(255, 85, 127) or Color3.fromRGB(45, 45, 60)

        TweenService:Create(Dot, TweenInfo.new(0.2), {Position = targetDotPos}):Play()
        TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = targetBtnBg}):Play()

        callback(state)
    end)
end

local function CreateDropdown(parent, text, options, defaultOption, callback)
    local DropFrame = Instance.new("Frame")
    DropFrame.Size = UDim2.new(1, -10, 0, 42)
    DropFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    DropFrame.ClipsDescendants = true
    DropFrame.Parent = parent

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = DropFrame

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.48, 0, 0, 42)
    Label.Position = UDim2.new(0, 12, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.TextColor3 = Color3.fromRGB(230, 230, 240)
    Label.Font = Enum.Font.Gotham
    Label.TextSize = 13
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = DropFrame

    local SelectBtn = Instance.new("TextButton")
    SelectBtn.Size = UDim2.new(0.48, 0, 0, 28)
    SelectBtn.Position = UDim2.new(0.48, 0, 0, 7)
    SelectBtn.BackgroundColor3 = Color3.fromRGB(38, 38, 52)
    SelectBtn.TextColor3 = Color3.fromRGB(255, 85, 127)
    SelectBtn.Text = defaultOption .. " ▼"
    SelectBtn.Font = Enum.Font.GothamMedium
    SelectBtn.TextSize = 11
    SelectBtn.Parent = DropFrame

    local SelectCorner = Instance.new("UICorner")
    SelectCorner.CornerRadius = UDim.new(0, 6)
    SelectCorner.Parent = SelectBtn

    local OptionHolder = Instance.new("Frame")
    OptionHolder.Size = UDim2.new(1, -24, 0, #options * 28)
    OptionHolder.Position = UDim2.new(0, 12, 0, 45)
    OptionHolder.BackgroundTransparency = 1
    OptionHolder.Parent = DropFrame

    local List = Instance.new("UIListLayout")
    List.Padding = UDim.new(0, 4)
    List.Parent = OptionHolder

    local expanded = false
    SelectBtn.MouseButton1Click:Connect(function()
        expanded = not expanded
        local targetSize = expanded and UDim2.new(1, -10, 0, 48 + (#options * 32)) or UDim2.new(1, -10, 0, 42)
        TweenService:Create(DropFrame, TweenInfo.new(0.25), {Size = targetSize}):Play()
    end)

    for _, opt in ipairs(options) do
        local OptBtn = Instance.new("TextButton")
        OptBtn.Size = UDim2.new(1, 0, 0, 28)
        OptBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 44)
        OptBtn.TextColor3 = Color3.fromRGB(200, 200, 220)
        OptBtn.Text = opt
        OptBtn.Font = Enum.Font.Gotham
        OptBtn.TextSize = 12
        OptBtn.Parent = OptionHolder

        local OptCorner = Instance.new("UICorner")
        OptCorner.CornerRadius = UDim.new(0, 4)
        OptCorner.Parent = OptBtn

        OptBtn.MouseButton1Click:Connect(function()
            SelectBtn.Text = opt .. " ▼"
            expanded = false
            TweenService:Create(DropFrame, TweenInfo.new(0.25), {Size = UDim2.new(1, -10, 0, 42)}):Play()
            callback(opt)
        end)
    end
end

