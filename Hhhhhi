-- ลูปทำงาน Auto Lift
task.spawn(function()
    while true do
        task.wait(0.1)
        if Config.AutoLift then
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    local toolName = Config.SelectedLiftTool
                    local backpackTool = LocalPlayer.Backpack:FindFirstChild(toolName)
                    local equippedTool = char:FindFirstChild(toolName)

                    -- ถืออุปกรณ์อัตโนมัติ
                    if backpackTool then
                        char.Humanoid:EquipTool(backpackTool)
                    end

                    -- ยิง Remote สำหรับปั๊มกล้าม
                    local muscleEvent = LocalPlayer:FindFirstChild("muscleEvent") or ReplicatedStorage:FindFirstChild("muscleEvent")
                    if muscleEvent then
                        muscleEvent:FireServer("rep")
                    end

                    local activeTool = char:FindFirstChildOfClass("Tool")
                    if activeTool then
                        activeTool:Activate()
                    end
                end
            end)
        end
    end
end)

