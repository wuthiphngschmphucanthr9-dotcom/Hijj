-- ลูปปั๊มกล้ามจากของในมือ (ถืออะไรอยู่ยกให้อัตโนมัติ ไม่ไปกดอย่างอื่น)
task.spawn(function()
    while true do
        task.wait() -- ทำงานไวระดับแม็กซ์
        if Config.AutoLiftSmart then
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    -- 1. ตรวจจับ Tool ในมือ
                    local heldTool = char:FindFirstChildOfClass("Tool")
                    
                    -- 2. ถ้ายังไม่ได้ถือไอเทม ให้ค้นหาไอเทมสำหรับปั๊มกล้ามมาถือให้อัตโนมัติ
                    if not heldTool then
                        for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
                            if tool:IsA("Tool") and (tool.Name == "Weight" or tool.Name == "Pushups" or tool.Name == "Situps" or tool.Name == "Punch" or tool.Name == "Handstands") then
                                char.Humanoid:EquipTool(tool)
                                heldTool = tool
                                break
                            end
                        end
                    end
                    
                    -- 3. ปั๊ม/ยก เฉพาะไอเทมที่ถืออยู่โดยไม่สลับปุ่ม
                    if heldTool then
                        local muscleEvent = LocalPlayer:FindFirstChild("muscleEvent") or ReplicatedStorage:FindFirstChild("muscleEvent")
                        if muscleEvent then
                            muscleEvent:FireServer("rep")
                        end
                        heldTool:Activate()
                    end
                end
            end)
        end
    end
end)

