    TabBtn.Text = icon .. " " .. name
    TabBtn.Font = Enum.Font.GothamMedium
    TabBtn.TextSize = 11
    TabBtn.TextXAlignment = Enum.TextXAlignment.Left
    TabBtn.Parent = TabHolder

    local BtnPadding = Instance.new("UIPadding")
    BtnPadding.PaddingLeft = UDim.new(0, 8)
    BtnPadding.Parent = TabBtn

    local TabPage = Instance.new("ScrollingFrame")
    TabPage.Size = UDim2.new(1, 0, 1, 0)
    TabPage.BackgroundTransparency = 1
    TabPage.BorderSizePixel = 0
    TabPage.ScrollBarThickness = 3
    TabPage.ScrollBarImageColor3 = Color3.fromRGB(255, 85, 127)
    TabPage.Visible = false
    TabPage.Parent = ContainerFrame

    local PageList = Instance.new("UIListLayout")
    PageList.SortOrder = Enum.SortOrder.LayoutOrder
    PageList.Padding = UDim.new(0, 6)
    PageList.Parent = TabPage

    TabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(Tabs) do
            t.Btn.TextColor3 = Color3.fromRGB(160, 160, 180)
            t.Btn.BackgroundTransparency = 1
            t.Page.Visible = false
        end
        TabBtn.TextColor3 = Color3.fromRGB(255, 85, 127)
        TabBtn.BackgroundTransparency = 0.8
        TabPage.Visible = true
    end)

    table.insert(Tabs, {Btn = TabBtn, Page = TabPage})

    if #Tabs == 1 then
        TabBtn.TextColor3 = Color3.fromRGB(255, 85, 127)
        TabBtn.BackgroundTransparency = 0.8
        TabPage.Visible = true
    end

    return TabPage
end

