    AutoStatCheck = true -- เช็กค่า Strength อัตโนมัติก่อน Rebirth
}

local Config = getgenv().SundayRebirth
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

----------------------------------------------------------------
-- CORE REBIRTH FUNCTION (ฟังก์ชัน Rebirth ที่ใช้งานได้จริง)
----------------------------------------------------------------
local function ExecuteRebirth()
    pcall(function()
        local rEvents = ReplicatedStorage:FindFirstChild("rEvents")
        
        -- วิธีที่ 1: เรียกผ่าน RemoteFunction (มาตรฐานของ Muscle Legends)
        if rEvents and rEvents:FindFirstChild("rebirthRemote") then
            rEvents.rebirthRemote:InvokeServer("rebirthRequest")
        end
        
        -- วิธีที่ 2: สำรองกรณีเกมอัปเดต RemoteEvent (Fallback)
        if rEvents and rEvents:FindFirstChild("rebirthEvent") then
            rEvents.rebirthEvent:FireServer("rebirthRequest")
        end

        -- วิธีที่ 3: เรียกผ่าน Root rEvents (โครงสร้างเวอร์ชันเก่า/เซิร์ฟเวอร์ย่อย)
        local rootRebirth = ReplicatedStorage:FindFirstChild("rebirthRemote") or ReplicatedStorage:FindFirstChild("rebirthRequest")
        if rootRebirth then
            if rootRebirth:IsA("RemoteFunction") then
                rootRebirth:InvokeServer()
            elseif rootRebirth:IsA("RemoteEvent") then
                rootRebirth:FireServer()
            end
        end
    end)
end

----------------------------------------------------------------
-- AUTO REBIRTH LOOP (ลูปทำงานอัตโนมัติ)
----------------------------------------------------------------
task.spawn(function()
    while true do
        task.wait(Config.Delay)
        if Config.Enabled then
            -- ตรวจสอบตัวละครและสถานะก่อนทำ Rebirth
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                ExecuteRebirth()
            end
        end
    end
end)

